{
  "name": "brasztech-instagram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev -p 3000",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx src/worker/main.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:backup": "tsx src/db/backup.ts",
    "db:restore": "tsx scripts/restore-backup.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "drain": "tsx scripts/drain-once.ts",
    "sim": "tsx scripts/e2e-sim.ts",
    "reset": "tsx scripts/reset-db.ts && tsx src/db/migrate.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "@libsql/client": "0.14.0",
    "drizzle-orm": "0.38.4",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "playwright": "1.49.1",
    "zod": "3.24.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "drizzle-kit": "0.30.2",
    "eslint": "9.18.0",
    "eslint-config-next": "15.1.6",
    "tailwindcss": "3.4.17",
    "postcss": "8.5.1",
    "autoprefixer": "10.4.20",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
