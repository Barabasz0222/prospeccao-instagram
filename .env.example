# ─────────────────────────────────────────────────────────────
# BraszTech Instagram — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.
# ─────────────────────────────────────────────────────────────

# ── Motor de conversação (Claude / Anthropic) ───────────────
CLAUDEIA_API_KEY=
# Nomes EXATOS dos modelos — sem alias flutuante em produção
CLAUDEIA_MODEL=claude-sonnet-5
CLAUDEIA_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDEIA_MONTHLY_BUDGET_USD=50

# ── Chrome real do operador (Playwright via CDP) ────────────
# Porta de debug SEMPRE em 127.0.0.1. Nunca 0.0.0.0. Nunca máquina compartilhada.
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=./.chrome-profile

# ── Instagram / Meta (API oficial + webhook) ───────────────
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Banco ──────────────────────────────────────────────────
DATABASE_URL=file:./data/app.db

# ── Ritmo humano / saúde da conta ──────────────────────────
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo

# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
# Modo do envio pelo navegador: simulation | dry_run | live
BROWSER_SEND_MODE=simulation
